FROM rust:latest

# Install cross-compilation tools for Windows
RUN apt-get update && \
    apt-get install -y \
    mingw-w64 \
    zip \
    && rm -rf /var/lib/apt/lists/*

# Install Rust Windows target
RUN rustup target add x86_64-pc-windows-gnu

WORKDIR /workspace

# Set environment variable to indicate Docker build
ENV DOCKER_BUILD=1

CMD ["bash", "build/windows-release.sh"]
