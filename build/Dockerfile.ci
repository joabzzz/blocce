FROM rust:1.89

# Install system dependencies for Bevy
RUN apt-get update && apt-get install -y \
    pkg-config \
    libx11-dev \
    libasound2-dev \
    libudev-dev \
    libxcb-render0-dev \
    libxcb-shape0-dev \
    libxcb-xfixes0-dev \
    libwayland-dev \
    libxkbcommon-dev \
    && rm -rf /var/lib/apt/lists/*

# Install clippy
RUN rustup component add clippy

WORKDIR /workspace

# Default command runs CI checks
CMD ["sh", "-c", "cargo clippy --all-targets -- -D warnings && cargo build --release"]
